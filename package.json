{
  "name": "paste",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm fixtures:render && pnpm secrets:compile && next dev -p 3025",
    "build": "pnpm fixtures:render && pnpm secrets:compile && next build",
    "start": "next start -p 3025",
    "lint": "eslint",
    "typecheck": "pnpm fixtures:render && pnpm secrets:compile && tsc --noEmit",
    "test": "pnpm fixtures:render && pnpm secrets:compile && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:render": "tsx scripts/render-fixtures.mts",
    "test:tz": "TZ=Pacific/Kiritimati pnpm fixtures:render && pnpm secrets:compile && TZ=Pacific/Kiritimati vitest run",
    "dev:raw": "next dev -p 3026",
    "start:raw": "next start -p 3026",
    "secrets:compile": "tsx scripts/compile-secret-rules.mts",
    "secrets:vendor": "tsx scripts/vendor-gitleaks.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
