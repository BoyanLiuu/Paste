# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example MUST be committed: it is the only record of which variables a
# fresh clone needs. `.env*` had been silently swallowing it since M3.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Generated by scripts/render-fixtures.mts. Not committed: it bakes the sample
# bodies into string literals, including deliberately credential-shaped ones, which
# GitHub push protection rejects (correctly). Regenerate with `pnpm fixtures:render`.
/src/lib/fixtures/renders.generated.ts
# Written by the same script. No secrets in it, but a committed artifact drifts from
# its generator, and `pnpm fixtures:render` runs before build, test and dev anyway.
/src/app/shiki-tokens.generated.css

# Compiled from vendor/gitleaks/gitleaks.toml by scripts/compile-secret-rules.mts.
/src/lib/secrets/rules.generated.ts

# Generated by `prisma generate` from prisma/schema.prisma. Follows the same rule as
# every other generated artifact here: not committed, because a committed copy drifts
# from the schema that produced it. `pnpm db:generate` runs before build, test, typecheck
# and dev, so a fresh clone never sees a missing module.
/src/generated/
